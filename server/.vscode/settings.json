{
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.compile.nullAnalysis.mode": "disabled",
  "java.jdt.ls.lombokSupport.enabled": true,
  "java.import.maven.enabled": true,
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.exclude": {
    "**/target": true,
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true
  },
  "[java]": {
    "editor.tabSize": 4
  }
}
